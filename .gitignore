node_modules/
dist/
dist-test/
# 零删除构建产物：`npm run build:iso` 输出到 dist-iso/
dist-iso/
# vitest 缓存目录（固定在仓库内，见 vitest.config.ts 的 cacheDir）
.vitest_cache/
# 构建前的临时改名产物（用于规避环境批量删除保护，见 skill safe-delete-guard-workarounds）
dist.prev-*/
# 探针/隔离构建目录（verify-dist.js 的输入，唯一路径避免删除）
dist-probe*/
# 被批量删除保护删成半拉子的产物（改名留证，见 tools/verify-dist.js 的说明）
dist.corrupt-*/
dist.bak.*/
release/
release.old/
# 隔离的打包输出目录（避免 electron-builder 清空 release/ 触发删除保护）
release2/
release-probe-*/
.vite/
backend/*.exe
backend/_internal/
backend/logs/
backend/data/
*.log
*.pid
.DS_Store
Thumbs.db
.guardvibe/
src/.guardvibe/
src/**/.guardvibe/
