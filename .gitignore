node_modules/
dist/
dist-test/
# 零删除构建产物：`npm run build:iso` 输出到 dist-iso/
dist-iso/
# vitest 缓存目录（固定在仓库内，见 vitest.config.ts 的 cacheDir）
.vitest_cache/
# 构建前的临时改名产物（用于规避环境批量删除保护，见 skill safe-delete-guard-workarounds）
dist.prev-*/
# 探针/隔离构建目录（verify-dist.js 的输入，唯一路径避免删除）
dist-probe*/
# 被批量删除保护删成半拉子的产物（改名留证，见 tools/verify-dist.js 的说明）
dist.corrupt-*/
dist.bak.*/
release/
release.old/
# 隔离的打包输出目录（避免 electron-builder 清空 release/ 触发删除保护）
release2/
release-probe-*/
# 版本号后缀的隔离打包输出（重出包专用，见 round 172）
release-*/
.vite/
backend/*.exe
backend/_internal/
backend/logs/
backend/data/
# 暂存目录改名 aside（规避环境批量删除保护，见 skill safe-delete-guard-workarounds）
backend.stale-*/
# 暂存目录重新暂存前的本地保留份（同日多轮重建用，2026-10-10）
backend.prev-*/
*.log
*.pid
.DS_Store
Thumbs.db
.guardvibe/
src/.guardvibe/
src/**/.guardvibe/
# 调试构建（vite build --minify false 的产物，2026-10-10 白屏事故排查用）
dist-dbg/

# 后端重打包产物与本地验收快照（2026-10-23）
.build-backend/
.ui-shots/
.tmp-shot.png
backend/metrics/
backend/prev-*/

# asar 解包检查目录（tools/prod-audit.js 用）
.prod-check/

# 开发态后端的运行期产物（2026-10-27 实测：跑一次接口冒烟就会生成，
# exports/ 是 CSV 导出、logs/ 是滚动日志/审计日志 —— 都不该进版本库）
backend/src/exports/
backend/src/logs/

# 证据夹具与临时用例库（可用 tools/make-evidence-fixture.py 重建，不入库）
tests/fixtures/

# 源码模式运行时生成（含随机密钥/诊断数据），禁止入库
backend/src/.env
backend/src/data/
backend/src/metrics/
