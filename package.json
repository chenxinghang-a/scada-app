{
  "name": "smartscada",
  "version": "1.3.1062",
  "description": "SmartSCADA - 工业数据采集与监控系统",
  "author": "陈星行",
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:iso": "vue-tsc --noEmit && vite build --outDir dist-iso",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "verify:dist": "node tools/verify-dist.js",
    "verify:asar": "node tools/verify-asar.js release/win-unpacked/resources/app.asar",
    "verify:staging": "node tools/verify-staging.js --dir backend",
    "verify:backend-runtime": "node tools/verify-backend-runtime.js --exe backend/scada-backend.exe",
    "verify:backend-runtime:shipped": "node tools/verify-backend-runtime.js --exe release/win-unpacked/resources/backend/scada-backend.exe",
    "verify:packaged": "npm run verify:asar && npm run verify:backend-runtime:shipped",
    "electron:build": "npm run verify:staging && npm run build && npm run verify:dist && electron-builder --win --publish never && npm run verify:packaged",
    "electron:build:dir": "npm run verify:staging && npm run build && npm run verify:dist && electron-builder --win --dir --publish never && npm run verify:asar",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.0",
    "axios": "^1.20.0",
    "echarts": "^5.6.0",
    "element-plus": "^2.9.0",
    "pinia": "^3.0.0",
    "socket.io-client": "^4.8.3",
    "vue": "^3.5.0",
    "vue-i18n": "^10.0.8",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/test-utils": "^2.4.0",
    "concurrently": "^9.1.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.0",
    "vue-tsc": "^2.2.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.smartscada.app",
    "productName": "SmartSCADA",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "resources/**/*"
    ],
    "extraResources": [
      {
        "from": "backend/",
        "to": "backend/",
        "filter": [
          "**/*",
          "!**/*.log",
          "!logs/**",
          "!exports/**",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "artifactName": "${name}-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SmartSCADA"
    },
    "forceCodeSigning": false
  }
}
